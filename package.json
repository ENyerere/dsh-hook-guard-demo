{
  "name": "dsh-hook-guard-demo",
  "description": "Demo consumer of dsh-hooks-bus: blocks dangerous shell commands through a declarative manifest subscription (the 'depended-on' path validation plugin).",
  "keywords": [
    "cordis",
    "cordis-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "hooks-bus",
    "guard"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "version": "0.1.0",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "hooks",
    "locale",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "hooksBus": {
    "subscriptions": [
      {
        "event": "PreToolUse",
        "priority": 100,
        "timeoutMs": 2000,
        "label": "dsh-hook-guard-demo",
        "handler": "./hooks/danger-guard.js"
      }
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown --config-loader unrun --config tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt --config .oxfmtrc.json --write src tests",
    "fmt:check": "oxfmt --config .oxfmtrc.json --check src tests",
    "lint": "oxlint --config .oxlintrc.json --type-check --deny-warnings src tests",
    "test": "vitest run"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7",
    "dsh-hooks-bus": ">=0.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^22.20.0",
    "cordis": "^4.0.0-rc.7",
    "dsh-hooks-bus": "link:../dsh-hooks-bus",
    "oxfmt": "0.64.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
